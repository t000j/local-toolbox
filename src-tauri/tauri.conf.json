{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalToolbox",
  "mainBinaryName": "LocalToolbox",
  "version": "0.1.4",
  "identifier": "cn.localtoolbox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalToolbox",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "theme": "Light",
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "轻便、简洁的本机工具集合",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "template": "windows/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NURDQjMzNDZBRkNCODgKUldTSXk2OUdNOHRkcGFGQzhzd3A2cjljU0Z3YXMzQTVtVlByc2h1dVRlc3lHMFVUWmVhOVprZ3QK",
      "endpoints": [
        "https://github.com/t000j/local-toolbox/releases/latest/download/latest.json"
      ]
    }
  }
}
