{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main toolbox window.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-hide", "core:window:allow-show", "dialog:allow-open", "dialog:allow-save", "clipboard-manager:allow-read-text", "clipboard-manager:allow-read-image", "clipboard-manager:allow-write-text", "clipboard-manager:allow-write-image", "updater:allow-check", "updater:allow-download", "updater:allow-install", "process:allow-restart"]
}
